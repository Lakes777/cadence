// Esquema do banco. O que o Prisma não sabe descrever (como a restrição contra reserva dupla)
// vai em SQL dentro da migração.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Papel {
  dono
  cliente
}

model Usuario {
  id        String   @id @default(uuid(7)) @db.Uuid
  nome      String
  /// Sempre em minúsculas e sem espaços nas pontas (normalizado antes de gravar)
  email     String   @unique
  /// scrypt$N$r$p$sal$hash (ver src/auth/senha.ts)
  senhaHash String   @map("senha_hash")
  papel     Papel
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  tokensDeRenovacao TokenDeRenovacao[]
  negocios          Negocio[]

  @@map("usuarios")
}

/// Cada login abre uma família; cada renovação gasta o token e cria o próximo da mesma família.
/// Token gasto usado de novo = roubo provável: a família inteira é revogada.
model TokenDeRenovacao {
  id              String    @id @default(uuid(7)) @db.Uuid
  usuarioId       String    @map("usuario_id") @db.Uuid
  familia         String    @db.Uuid
  /// Quando o login que abriu a família aconteceu: depois de 90 dias, entra de novo com a senha
  familiaCriadaEm DateTime  @map("familia_criada_em") @db.Timestamptz(3)
  /// SHA-256 do token; o token em si só existe no cookie do navegador
  hash            String    @unique
  expiraEm        DateTime  @map("expira_em") @db.Timestamptz(3)
  usadoEm         DateTime? @map("usado_em") @db.Timestamptz(3)
  revogadoEm      DateTime? @map("revogado_em") @db.Timestamptz(3)
  criadoEm        DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([familia])
  @@index([usuarioId])
  @@map("tokens_de_renovacao")
}

/// Um dono pode ter mais de um negócio; o cliente chega pelo slug (cadence/.../barbearia-exemplo)
model Negocio {
  id       String   @id @default(uuid(7)) @db.Uuid
  donoId   String   @map("dono_id") @db.Uuid
  nome     String
  slug     String   @unique
  /// Fuso IANA em que valem os horários semanais (ex.: America/Sao_Paulo)
  fuso     String   @default("America/Sao_Paulo")
  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  dono          Usuario        @relation(fields: [donoId], references: [id], onDelete: Cascade)
  profissionais Profissional[]
  servicos      Servico[]
  bloqueios     Bloqueio[]

  @@index([donoId])
  @@map("negocios")
}

model Profissional {
  id        String   @id @default(uuid(7)) @db.Uuid
  negocioId String   @map("negocio_id") @db.Uuid
  nome      String
  /// Desativar em vez de apagar: as reservas antigas continuam apontando para ele
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  negocio   Negocio               @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  servicos  ProfissionalServico[]
  horarios  HorarioDeTrabalho[]
  bloqueios Bloqueio[]

  @@unique([id, negocioId])
  @@index([negocioId])
  @@map("profissionais")
}

model Servico {
  id            String   @id @default(uuid(7)) @db.Uuid
  negocioId     String   @map("negocio_id") @db.Uuid
  nome          String
  duracaoMin    Int      @map("duracao_min")
  /// Em centavos, para não ter erro de arredondamento
  precoCentavos Int      @map("preco_centavos")
  ativo         Boolean  @default(true)
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  negocio       Negocio               @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  profissionais ProfissionalServico[]

  @@unique([id, negocioId])
  @@index([negocioId])
  @@map("servicos")
}

/// Quais serviços cada profissional faz. O negocio_id entra nas duas chaves estrangeiras: o
/// banco recusa ligar o profissional de um negócio ao serviço de outro.
model ProfissionalServico {
  profissionalId String @map("profissional_id") @db.Uuid
  servicoId      String @map("servico_id") @db.Uuid
  negocioId      String @map("negocio_id") @db.Uuid

  profissional Profissional @relation(fields: [profissionalId, negocioId], references: [id, negocioId], onDelete: Cascade)
  servico      Servico      @relation(fields: [servicoId, negocioId], references: [id, negocioId], onDelete: Cascade)

  @@id([profissionalId, servicoId])
  @@index([servicoId])
  @@map("profissionais_servicos")
}

/// Horário semanal, na hora local do negócio: minutos desde a meia-noite (540 = 09:00).
/// Vários por dia (ex.: 09-12 e 13-18); o banco não deixa dois se sobreporem.
model HorarioDeTrabalho {
  id             String @id @default(uuid(7)) @db.Uuid
  profissionalId String @map("profissional_id") @db.Uuid
  /// 0 = domingo ... 6 = sábado
  diaDaSemana    Int    @map("dia_da_semana")
  inicioMin      Int    @map("inicio_min")
  fimMin         Int    @map("fim_min")

  profissional Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)

  @@index([profissionalId])
  @@map("horarios_de_trabalho")
}

/// Folga, férias, feriado: um intervalo de tempo absoluto (UTC). Sem profissional = o negócio todo.
model Bloqueio {
  id             String   @id @default(uuid(7)) @db.Uuid
  negocioId      String   @map("negocio_id") @db.Uuid
  profissionalId String?  @map("profissional_id") @db.Uuid
  inicio         DateTime @db.Timestamptz(3)
  fim            DateTime @db.Timestamptz(3)
  motivo         String?
  criadoEm       DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  negocio      Negocio       @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  profissional Profissional? @relation(fields: [profissionalId], references: [id], onDelete: Cascade)

  @@index([negocioId, inicio])
  @@index([profissionalId])
  @@map("bloqueios")
}
