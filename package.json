{
  "name": "cadence",
  "version": "0.0.1",
  "description": "Agenda de reservas sem reserva dupla (NestJS + PostgreSQL)",
  "author": "André Lagos",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "gerar": "prisma generate",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.ts\"",
    "format:conferir": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.ts\"",
    "start:dev": "nest start --watch --exec \"node --env-file=.env\"",
    "start:prod": "node dist/main",
    "migrar": "node --env-file=.env node_modules/prisma/build/index.js migrate deploy",
    "migrar:criar": "node --env-file=.env node_modules/prisma/build/index.js migrate dev --create-only",
    "lint": "oxlint --type-aware --deny-warnings src/ test/",
    "tipos": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bullmq": "^6.3.12",
    "cookie-parser": "^1.4.7",
    "ioredis": "^5.11.1",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.1",
    "pino-http": "^11.0.0",
    "proxy-addr": "^2.0.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@testcontainers/postgresql": "^12.2.0",
    "@testcontainers/redis": "^12.2.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/proxy-addr": "^2.0.3",
    "@types/supertest": "^7.0.0",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.4.2",
    "prisma": "^7.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=24"
  }
}
