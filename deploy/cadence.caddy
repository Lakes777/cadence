# Site do Cadence no Caddy do Beacon (copiado para ~/beacon/sites/ pelo publicar.sh). O Caddy pega
# o certificado HTTPS sozinho e repassa o WebSocket (/tempo-real) sem configuração extra.
# DOMINIO_CADENCE é trocado pelo endereço na publicação.
DOMINIO_CADENCE {
	encode gzip
	reverse_proxy cadence:3000
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Tudo do próprio endereço; o WebSocket também (wss://). Nenhum script ou estilo inline.
		Content-Security-Policy "default-src 'self'; connect-src 'self' wss://DOMINIO_CADENCE; img-src 'self' data:; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}
}
