# Copie para .env (que não vai para o git) e ajuste
NODE_ENV=development
DATABASE_URL=postgresql://cadence:cadence@localhost:5434/cadence
PORTA=3000
NIVEL_DO_LOG=info
# Gere um seu: openssl rand -hex 32 (este valor é curto de propósito: a API recusa e não sobe)
JWT_SEGREDO=troque-isto
PEDIDOS_DE_CONTA_POR_MINUTO=10
# Quem pode informar o IP real em X-Forwarded-For (o Caddy). loopback = mesma máquina;
# com o Caddy em container, use uniquelocal ou a sub-rede do Docker (ex.: 172.30.0.0/24)
CONFIANCA_NO_PROXY=loopback
